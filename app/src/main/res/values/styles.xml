<resources>
    <!-- Base theme for Resource Manager -->
    <style name="Theme.NOVAHD.ResourceManager" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nova_primary</item>
        <item name="colorPrimaryVariant">@color/nova_primary_dark</item>
        <item name="colorOnPrimary">@color/nova_on_primary</item>
        <item name="colorSecondary">@color/nova_accent</item>
        <item name="colorSecondaryVariant">@color/nova_accent_dark</item>
        <item name="colorOnSecondary">@color/nova_on_accent</item>
        <item name="android:colorBackground">@color/nova_background</item>
        <item name="colorSurface">@color/nova_surface</item>
        <item name="colorOnSurface">@color/nova_on_surface</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.NOVAHD.ResourceManager.Fullscreen" parent="Theme.NOVAHD.ResourceManager">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.NOVAHD.Game.Fullscreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Progress bar style -->
    <style name="Widget.NOVAHD.ProgressBar" parent="Widget.MaterialComponents.LinearProgressIndicator">
        <item name="trackThickness">8dp</item>
        <item name="indicatorSize">8dp</item>
        <item name="indicatorColor">@color/nova_accent</item>
        <item name="trackColor">@color/nova_progress_track</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.NOVAHD.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/nova_accent</item>
        <item name="android:textColor">@color/nova_on_accent</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.NOVAHD.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/nova_accent</item>
        <item name="android:textColor">@color/nova_accent</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.NOVAHD.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/nova_on_surface</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.NOVAHD.Title" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/nova_on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.NOVAHD.Subtitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/nova_accent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.NOVAHD.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/nova_on_surface</item>
    </style>

    <style name="TextAppearance.NOVAHD.Mono" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/nova_on_surface_variant</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.NOVAHD.Status" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/nova_on_surface_variant</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
