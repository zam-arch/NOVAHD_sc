<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00010001" android:required="true" />
    <application android:name=".RecoveryApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_nova_logo"
        android:label="@string/app_name"
        android:theme="@style/Theme.NOVAHD.ResourceManager"
        android:usesCleartextTraffic="false">
        
        <activity
            android:name=".ResourceManagerActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/Theme.NOVAHD.ResourceManager.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MusicActivity" android:exported="false"
            android:label="Música personalizada" android:screenOrientation="sensorLandscape" />

        <activity android:name=".GraphicsDiagnosticsActivity"
            android:process=":graphics_probe"
            android:exported="false" />

        <activity
            android:name=".GameActivity"
            android:exported="false" android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|navigation|uiMode|density"
            android:theme="@style/Theme.NOVAHD.Game.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="novahd" />
        </activity>

    </application>
</manifest>
